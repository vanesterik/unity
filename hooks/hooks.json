{
  "description": "unity guardrails: /unity:test may only edit test paths while a test run is active.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/edit-guard.js\""
          }
        ]
      }
    ]
  }
}
